@model List<IntroduccionCsharp.Models.Pelicula>
@{ ViewBag.Title = "MuestraPeliculas";
    
    }

<h2>Muestra Peliculas</h2><div class="container">
    <div class="row">
        <table>
            <thead>
            <th>Titulo</th>
            <th>Duración</th>
            <th>País</th>
            <th>Lanzamiento</th></thead>
            <tbody>
                @foreach (var pelicula in Model)

                {
                    <tr><td>@pelicula.Titulo</td>
                    <td>@pelicula.Duracion</td>
                    <td>@pelicula.Pais</td>
                    <td>@pelicula.Publicacion.ToString("dd/MM/yyyy")</td>
                    </tr>
                    }
        </tbody>
    </table>
</div>
</div>